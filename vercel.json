{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "www.seagamafh.com"
                }
            ],
            "destination": "https://seagamafh.com/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "www.seagam.vercel.app"
                }
            ],
            "destination": "https://seagam.vercel.app/$1",
            "permanent": true
        }
    ]
}